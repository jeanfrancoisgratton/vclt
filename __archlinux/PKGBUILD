# Maintainer: J.F.Gratton <jean-francois@famillegratton.net>
# Packager: Package builder <builder@famillegratton.net>

pkgname=vclt
pkgver=2.6.0
pkgrel=1
pkgdesc="Hashicorp Vault client"
arch=('x86_64')
url="https://git.famillegratton.net:3000/devops/vclt.git"
license=('GPL-2.0-only')

makedepends=('go')
#depends=('bash-completion')

#optdepends=('zsh: zsh completion support')

options=('!debug')

_binaryname='vclt'
_builddir="${pkgname}-${pkgver}"

install=vclt.install

prepare() {
  rm -rf "${srcdir:?}/${_builddir}"
  mkdir -p "${srcdir}/${_builddir}"

  cp -a "${startdir}/../src/." "${srcdir}/${_builddir}/"
}

build() {
  cd "${srcdir}/${_builddir}"

  export CGO_ENABLED=0
  export GOPATH="${srcdir}/gopath"
  export GOMODCACHE="${GOPATH}/pkg/mod"

  # makepkg only runs check() when invoked with --check, which the packaging
  # Makefile never passes, so vet/test are run inline here instead to
  # guarantee they always run. makepkg runs build() under bash's default
  # errexit-on-uncaught-error behavior for the script as a whole, so both of
  # these fast-fail; go test exits 0 for packages with no test files and
  # only fails on an actual test failure.
  /opt/go/bin/go vet -modcacherw ./...
  /opt/go/bin/go test -modcacherw ./...

  builddate="$(date +%Y.%m.%d)"

  /opt/go/bin/go build -trimpath -mod=readonly -modcacherw -ldflags="-s -w -buildid= -X vclt/cmd.buildVersion=${pkgver} -X vclt/cmd.buildDate=${builddate}" -o "${_binaryname}" .
}

package() {
  cd "${srcdir}/${_builddir}"

  install -Dm0755 "${_binaryname}" "${pkgdir}/opt/bin/${_binaryname}"
}
