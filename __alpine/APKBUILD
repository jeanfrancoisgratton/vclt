# Maintainer: J.F. Gratton <jean-francois@famillegratton.net>
# Packager: APK/DEB/RPM package builder <builder@famillegratton.net>
pkgname=vclt
pkgver=2.5.0
pkgrel=1
pkgdir=/data/packages
builddir="$startdir/src/BUILD"
pkgdesc="Hashicorp Vault client"
url="https://git.famillegratton.net:3000/devops/vclt.git"
arch=x86_64
license=GPL2
depends="gcompat"
#install="$pkgname.pre-install $pkgname.post-install"
#source="$pkgname-$pkgver-$pkgrel.tar.bz2::http://localhost/$pkgname-$pkgver-$pkgrel.tar.bz2"
binaryname=vclt

prepare() {
	mkdir -p "$builddir"
	cp -R "$startdir"/../src/* "$builddir"/
}

build() {
	cd "$builddir"

	/opt/go/bin/go env | egrep 'GOFLAGS|CGO_ENABLED|GOOS|GOARCH' || true

	# abuild runs build() with set -e, so both of these fast-fail the package
	# build; go test exits 0 for packages with no test files and only fails
	# on an actual test failure.
	/opt/go/bin/go vet ./...
	/opt/go/bin/go test ./...

	builddate="$(date +%Y.%m.%d)"

	# Static, non-PIE, internal linker
	CGO_ENABLED=0 /opt/go/bin/go build -trimpath -ldflags="-s -w -buildid= -linkmode=internal -X vclt/cmd.buildVersion=$pkgver -X vclt/cmd.buildDate=$builddate" -o "$binaryname" .
}

package() {
	install -d "$pkgdir"/opt/bin
	install -m755 "$builddir/$binaryname" "$pkgdir/opt/bin/$binaryname"
}

